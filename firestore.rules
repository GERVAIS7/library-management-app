rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- USERS ----------
    // A user can read any profile (needed to show display names on loans),
    // but can only create/update their OWN profile document.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ---------- AUTHORS ----------
    // Referenced by Book but not owned by any single user.
    // Any authenticated user may read, create, update, or delete —
    // this is a simple shared catalog, not an ownership-protected entity.
    match /authors/{authorId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ---------- BOOKS ----------
    // Owned by the user who catalogued them (ownerId == uid).
    // Anyone authenticated can read (library feed is shared).
    // Only the owner can create/delete, or change most fields.
    // EXCEPTION: any authenticated user may update ONLY copiesAvailable —
    // this is what lets a borrower's Loan decrement/increment the count
    // without needing to own the Book.
    match /books/{bookId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
                    && (
                      resource.data.ownerId == request.auth.uid
                      || request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['copiesAvailable'])
                    );
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // ---------- LOANS ----------
    // Join entity between User and Book. Only the borrower can see,
    // create, or modify their own loan records.
    match /loans/{loanId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }
  }
}
